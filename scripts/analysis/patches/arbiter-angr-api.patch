@@ -436,14 +451,16 @@ class CheckpointHook(DefaultHook):
     def run(self, **kwargs):
         assert 'arg_num' in kwargs['kwargs']
         arg_num = kwargs['kwargs']['arg_num']
-        if self.state.globals.get('globals', None) is None:
